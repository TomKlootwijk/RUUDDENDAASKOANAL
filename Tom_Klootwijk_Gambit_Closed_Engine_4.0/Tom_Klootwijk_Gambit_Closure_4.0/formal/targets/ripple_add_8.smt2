; Tom Klootwijk Gambit 4.0 -- ripple_add_8
(set-option :produce-proofs true)
(set-option :timeout 15000)
(declare-const a (_ BitVec 8))(declare-const b (_ BitVec 8))
(define-fun c0 () Bool false)
(define-fun a0 () Bool (= ((_ extract 0 0) a) #b1))
(define-fun b0 () Bool (= ((_ extract 0 0) b) #b1))
(define-fun s0 () (_ BitVec 1) (ite (xor (xor a0 b0) c0) #b1 #b0))
(define-fun c1 () Bool (or (and a0 b0) (and (xor a0 b0) c0)))
(define-fun a1 () Bool (= ((_ extract 1 1) a) #b1))
(define-fun b1 () Bool (= ((_ extract 1 1) b) #b1))
(define-fun s1 () (_ BitVec 1) (ite (xor (xor a1 b1) c1) #b1 #b0))
(define-fun c2 () Bool (or (and a1 b1) (and (xor a1 b1) c1)))
(define-fun a2 () Bool (= ((_ extract 2 2) a) #b1))
(define-fun b2 () Bool (= ((_ extract 2 2) b) #b1))
(define-fun s2 () (_ BitVec 1) (ite (xor (xor a2 b2) c2) #b1 #b0))
(define-fun c3 () Bool (or (and a2 b2) (and (xor a2 b2) c2)))
(define-fun a3 () Bool (= ((_ extract 3 3) a) #b1))
(define-fun b3 () Bool (= ((_ extract 3 3) b) #b1))
(define-fun s3 () (_ BitVec 1) (ite (xor (xor a3 b3) c3) #b1 #b0))
(define-fun c4 () Bool (or (and a3 b3) (and (xor a3 b3) c3)))
(define-fun a4 () Bool (= ((_ extract 4 4) a) #b1))
(define-fun b4 () Bool (= ((_ extract 4 4) b) #b1))
(define-fun s4 () (_ BitVec 1) (ite (xor (xor a4 b4) c4) #b1 #b0))
(define-fun c5 () Bool (or (and a4 b4) (and (xor a4 b4) c4)))
(define-fun a5 () Bool (= ((_ extract 5 5) a) #b1))
(define-fun b5 () Bool (= ((_ extract 5 5) b) #b1))
(define-fun s5 () (_ BitVec 1) (ite (xor (xor a5 b5) c5) #b1 #b0))
(define-fun c6 () Bool (or (and a5 b5) (and (xor a5 b5) c5)))
(define-fun a6 () Bool (= ((_ extract 6 6) a) #b1))
(define-fun b6 () Bool (= ((_ extract 6 6) b) #b1))
(define-fun s6 () (_ BitVec 1) (ite (xor (xor a6 b6) c6) #b1 #b0))
(define-fun c7 () Bool (or (and a6 b6) (and (xor a6 b6) c6)))
(define-fun a7 () Bool (= ((_ extract 7 7) a) #b1))
(define-fun b7 () Bool (= ((_ extract 7 7) b) #b1))
(define-fun s7 () (_ BitVec 1) (ite (xor (xor a7 b7) c7) #b1 #b0))
(define-fun c8 () Bool (or (and a7 b7) (and (xor a7 b7) c7)))
(assert (not (= (concat (concat (concat (concat (concat (concat (concat s7 s6) s5) s4) s3) s2) s1) s0) (bvadd a b))))
(check-sat)
(get-proof)
