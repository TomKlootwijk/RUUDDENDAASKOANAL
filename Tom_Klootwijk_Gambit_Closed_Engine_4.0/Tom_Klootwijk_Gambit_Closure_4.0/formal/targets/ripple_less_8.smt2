; Tom Klootwijk Gambit 4.0 -- ripple_less_8
(set-option :produce-proofs true)
(set-option :timeout 15000)
(declare-const a (_ BitVec 8))(declare-const b (_ BitVec 8))
(define-fun c0 () Bool false)
(define-fun a0 () Bool (= ((_ extract 0 0) a) #b1))
(define-fun b0 () Bool (= ((_ extract 0 0) b) #b1))
(define-fun c1 () Bool (or (and (not a0) b0) (and (not (xor a0 b0)) c0)))
(define-fun a1 () Bool (= ((_ extract 1 1) a) #b1))
(define-fun b1 () Bool (= ((_ extract 1 1) b) #b1))
(define-fun c2 () Bool (or (and (not a1) b1) (and (not (xor a1 b1)) c1)))
(define-fun a2 () Bool (= ((_ extract 2 2) a) #b1))
(define-fun b2 () Bool (= ((_ extract 2 2) b) #b1))
(define-fun c3 () Bool (or (and (not a2) b2) (and (not (xor a2 b2)) c2)))
(define-fun a3 () Bool (= ((_ extract 3 3) a) #b1))
(define-fun b3 () Bool (= ((_ extract 3 3) b) #b1))
(define-fun c4 () Bool (or (and (not a3) b3) (and (not (xor a3 b3)) c3)))
(define-fun a4 () Bool (= ((_ extract 4 4) a) #b1))
(define-fun b4 () Bool (= ((_ extract 4 4) b) #b1))
(define-fun c5 () Bool (or (and (not a4) b4) (and (not (xor a4 b4)) c4)))
(define-fun a5 () Bool (= ((_ extract 5 5) a) #b1))
(define-fun b5 () Bool (= ((_ extract 5 5) b) #b1))
(define-fun c6 () Bool (or (and (not a5) b5) (and (not (xor a5 b5)) c5)))
(define-fun a6 () Bool (= ((_ extract 6 6) a) #b1))
(define-fun b6 () Bool (= ((_ extract 6 6) b) #b1))
(define-fun c7 () Bool (or (and (not a6) b6) (and (not (xor a6 b6)) c6)))
(define-fun a7 () Bool (= ((_ extract 7 7) a) #b1))
(define-fun b7 () Bool (= ((_ extract 7 7) b) #b1))
(define-fun c8 () Bool (or (and (not a7) b7) (and (not (xor a7 b7)) c7)))
(assert (not (= c8 (bvult a b))))
(check-sat)
(get-proof)
